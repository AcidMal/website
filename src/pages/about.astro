---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | AcidMal">
  <div class="max-w-4xl mx-auto">
    <h1 class="reveal text-4xl font-bold mb-8">About AcidMal</h1>
    <div class="pop-card reveal bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg" style="--d: 80ms">
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        I'm AcidMal. This site is where I keep notes on the things I build. The project I am working on now is
        MomoBot, a Discord bot for moderation and community tools. The dashboard is at
        <a
          href="https://dash.momobot.app"
          target="_blank"
          rel="noopener noreferrer"
          class="text-purple-400 transition-colors duration-300 hover:text-purple-600 dark:hover:text-purple-300"
        >dash.momobot.app</a>.
      </p>

      <p class="text-gray-600 dark:text-gray-300">
        The contact page is the way to reach me.
      </p>
    </div>
  </div>
</Layout>


